// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// Get a free hosted Postgres database in seconds: `npx create-db`

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String

  displayName String?
  avatar      String?
  bio         String?

  securityQuestion String?
  securityAnswer   String?

  visitCount  Int      @default(0)

  createdAt   DateTime @default(now())

  sentRequests     FriendRequest[] @relation("Sender")
  receivedRequests FriendRequest[] @relation("Receiver")


  directMessages DirectMessage[]
  conversations Conversation[] @relation("UserConversations")
  notifications Notification[]
}

model FriendRequest {
  id         String   @id @default(cuid())

  senderId   String
  receiverId String

  sender      User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  status      String @default("pending")

  createdAt   DateTime @default(now())
}


model Feedback {
  id        String   @id @default(cuid())
  alias     String
  universe  String?
  content   String
  createdAt DateTime @default(now())
}

model Conversation {
  id            String   @id @default(cuid())
  participants  User[]   @relation("UserConversations")
  lastMessage   String?
  lastMessageAt DateTime @default(now())
  unreadCounts  Json?    @default("{}")
  messages      DirectMessage[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DirectMessage {
  id             String   @id @default(cuid())
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  senderId       String
  sender         User @relation(fields: [senderId], references: [id])
  
  content        String
  type           String   @default("text")
  status         String   @default("sent")
  
  replyTo        String?
  reactions      Json?    @default("[]")
  
  deleted        Boolean  @default(false)
  attachments    Json?    @default("[]")
  
  createdAt      DateTime @default(now())
  editedAt       DateTime?

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // e.g., 'system_alert', 'friend_request'
  message     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}



model ModerationLog {
  logId           String   @id @default(cuid())
  messageId       String?
  source          String   // "ROOM" or "DM"
  roomId          String?
  conversationId  String?
  senderId        String?
  senderName      String
  recipientId     String?
  recipientName   String?
  messageType     String   @default("text")
  createdAt       DateTime @default(now())
  status          String   @default("ACTIVE")
  isGuest         Boolean  @default(false)
  isAuthenticated Boolean  @default(true)

  @@index([source])
  @@index([senderId])
  @@index([roomId])
  @@index([conversationId])
  @@index([createdAt])
}